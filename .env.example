# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# GOOGLE_SHEET_WEBHOOK_URL: Webapp URL from Google Apps Script to pull/push data.
# When configured, database is hydrated automatically on application startup.
GOOGLE_SHEET_WEBHOOK_URL=""

# RATE LIMITING CONFIGURATIONS (Configurable, with default fallbacks)
# Strict limit for authentication routes (e.g. login, signup) per IP
AUTH_LIMIT_IP_MAX=10
AUTH_LIMIT_IP_WINDOW_MS=60000

# Exponential backoff parameters for failed account-specific auth attempts
AUTH_BACKOFF_BASE_MS=1000
AUTH_BACKOFF_FACTOR=2
AUTH_MAX_BACKOFF_MS=60000

# Moderate limit for public endpoints per IP
PUBLIC_LIMIT_MAX=30
PUBLIC_LIMIT_WINDOW_MS=60000

# Loose limit for authenticated user actions per IP
AUTHED_LIMIT_MAX=300
AUTHED_LIMIT_WINDOW_MS=60000

# VITE_API_BASE_URL: The remote server backend base URL for frontend fetch calls when packaged as an Android/Capacitor App (e.g. https://your-server.render.com). Leave empty for relative local host paths.
VITE_API_BASE_URL=""

# FIREBASE CONFIGURATIONS: Required to sync the local database with a durable, live cloud database (like Firestore)
FIREBASE_PROJECT_ID=""
FIREBASE_APP_ID=""
FIREBASE_API_KEY=""
FIREBASE_AUTH_DOMAIN=""
FIREBASE_DATABASE_ID=""
FIREBASE_STORAGE_BUCKET=""
FIREBASE_MESSAGING_SENDER_ID=""


